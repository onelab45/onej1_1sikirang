# 식이랑 환경변수 템플릿 파일 (.env.example)
# 이 파일을 복사하여 .env 파일을 생성하고 실제 운영 서버 값을 채워 넣으세요.

# Django의 암호화 및 서명 처리에 필요한 비밀키 (실제 운영 시에는 매우 무작위하고 고유한 문자열로 변경 필수)
SECRET_KEY=

# 디버그 모드 작동 여부 (운영 배포 시에는 반드시 False로 지정해야 합니다)
DEBUG=False

# 허용할 도메인 주소 목록 (콤마 ','로 구분하여 입력, 공백 없이 작성해야 합니다)
# 예: myapp-12345.a.run.app,127.0.0.1
ALLOWED_HOSTS=

# CSRF 신뢰할 수 있는 Origin 도메인 리스트 (프로토콜 포함 필수, 콤마 ','로 구분)
# 예: https://myapp-12345.a.run.app,http://localhost:8000
CSRF_TRUSTED_ORIGINS=

# SQLite 데이터베이스 파일 저장 절대 경로
# Cloud Run 배포 시 볼륨 마운트된 영구 디스크 경로를 지정합니다.
# 예: /mnt/data/db.sqlite3
DATABASE_PATH=
